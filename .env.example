# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model routing (defaults shown). Fast = bulk extraction, smart = reasoning.
FINN_MODEL_FAST=gemini-3.5-flash-lite
FINN_MODEL_SMART=gemini-3.6-flash
# Free-tier pacing between model calls, seconds
FINN_LLM_MIN_INTERVAL=4.2

# Or any OpenAI-compatible provider (Groq, OpenRouter, Ollama):
# FINN_LLM_PROVIDER=openai
# FINN_OPENAI_BASE=https://api.groq.com/openai/v1
# FINN_OPENAI_KEY=
# FINN_MODEL_FAST=llama-3.1-8b-instant
# FINN_MODEL_SMART=llama-3.3-70b-versatile

# Optional: web bios for incoming executives (either one)
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional: real push to Telegram after the nightly build
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
